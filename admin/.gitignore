# ===========================
# Flutter Admin .gitignore
# ===========================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.packages

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Firebase credentials (NEVER push)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase_app_id_file.json
lib/firebase_options.dart

# Generated
*.g.dart
*.freezed.dart
*.mocks.dart

# Dev-only task notes
task.md
